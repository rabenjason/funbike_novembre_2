{
  "name": "funbike-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend GraphQL du site Funbike (catalogue, accueil configurable, admin).",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
