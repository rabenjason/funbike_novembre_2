# =====================================================================
#  Funbike — configuration locale (copier vers .env à la racine)
# =====================================================================

# Base de données MySQL (consultable dans phpMyAdmin)
DATABASE_URL=mysql://funbike_user:FunbikeLocal2026@127.0.0.1:3306/funbike

# API GraphQL
API_PORT=4000
API_PROXY_TARGET=http://127.0.0.1:4000

# Jetons d'authentification du dashboard
JWT_SECRET=funbike_local_secret_key_2026_change_this_before_production
JWT_EXPIRES_IN=8h

# Compte administrateur créé au premier démarrage (dashboard /admin)
INITIAL_ADMIN_EMAIL=admin@funbike.local
INITIAL_ADMIN_PASSWORD=tojosoa1998.
